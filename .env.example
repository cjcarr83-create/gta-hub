# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Service role key — server-only, never exposed to the client.
# Used exclusively in lib/supabase/trusted.ts (webhooks + payment routes).
SUPABASE_SERVICE_ROLE_KEY=

# Mux — from your Mux dashboard
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Stripe — from your Stripe dashboard (use test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public app URL (used for Mux CORS origin, Stripe redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vantra Studios brand attribution — public link destination only,
# no data dependency. Defaults to https://vantrastudios.com if unset.
NEXT_PUBLIC_VANTRA_STUDIOS_URL=https://vantrastudios.com

# YouTube Data API v3 key — used only for the admin console's YouTube
# sync (pulling trailer/news metadata for the Launch Hub). Get one from
# console.cloud.google.com — enable "YouTube Data API v3" on a project,
# then create an API key. Free tier quota is generous for occasional
# admin-triggered syncs.
YOUTUBE_API_KEY=

# AI avatar generation (Round 7) — used only in lib/avatarGen.ts, in the
# trusted server route app/api/profile/generate-avatar. No provider is
# wired up yet; see the comment above generateAvatarImage() in
# lib/avatarGen.ts for what to implement once you've picked a vendor
# (OpenAI Images, Replicate, Stability, etc).
AVATAR_PROVIDER_API_KEY=
